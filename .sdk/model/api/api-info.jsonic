# API Information


main: {
  kit: {
    info: {
      contact: {
        url: "https://starwars-databank.vercel.app/"
      }
      description: "The Star Wars Databank API provides access to a comprehensive collection of data related to the Star Wars universe including characters, droids, creatures, locations, organizations, species, and vehicles. It is a RESTful API that presents official information derived directly from the Star Wars Databank, allowing users to explore and interact with the vast lore of the saga."
      servers: [
        {
          description: "Production server"
          url: "https://starwars-databank-server.onrender.com/api/v1"
        }
      ]
      title: "Star Wars Databank API"
      version: "2.5.0"
    }
  }
}

}