# Entity: creature

main: kit: entity: creature: {

  alias: field: {}

  fields: {
    classification: {
      h: "Classification"
      n: "classification"
      r: false
      sh: "Creature's classification"
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed description of the creature"
      t: "`$STRING`"
    }
    habitat: {
      h: "Habitat"
      n: "habitat"
      r: false
      sh: "Creature's natural habitat"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the creature"
      t: "`$STRING`"
    }
    image: {
      fo: "uri"
      h: "Image"
      n: "image"
      r: false
      sh: "URL to the creature's image"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the creature"
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      sh: "URL to the official Star Wars Databank entry"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "creature"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /creatures"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/creatures"
          q: {
            exist: [
              "limit"
              "page"
            ]
          }
          s: [
            {
              lit: "creatures"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /creatures/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/creatures/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "creatures"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
