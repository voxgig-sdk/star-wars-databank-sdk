# Entity: location

main: kit: entity: location: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Detailed description of the location"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the location"
      type: "`$STRING`"
    }
    {
      name: "image"
      req: false
      short: "URL to the location's image"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the location"
      type: "`$STRING`"
    }
    {
      name: "region"
      req: false
      short: "Galactic region where the location is situated"
      type: "`$STRING`"
    }
    {
      name: "sector"
      req: false
      short: "Sector where the location is situated"
      type: "`$STRING`"
    }
    {
      name: "terrain"
      req: false
      short: "Terrain type of the location"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "URL to the official Star Wars Databank entry"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "location"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/locations"
          parts: [
            "locations"
          ]
          select: {
            exist: [
              "limit"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/locations/{id}"
          parts: [
            "locations"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
