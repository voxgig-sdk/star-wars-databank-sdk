# Entity: character

main: kit: entity: character: {

  alias: field: {}

  fields: {
    affiliation: {
      h: "Affiliation"
      n: "affiliation"
      r: false
      sh: "Character's affiliation or allegiance"
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed description of the character"
      t: "`$STRING`"
    }
    homeworld: {
      h: "Homeworld"
      n: "homeworld"
      r: false
      sh: "Character's home planet"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the character"
      t: "`$STRING`"
    }
    image: {
      fo: "uri"
      h: "Image"
      n: "image"
      r: false
      sh: "URL to the character's image"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the character"
      t: "`$STRING`"
    }
    species: {
      h: "Species"
      n: "species"
      r: false
      sh: "Character's species"
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      sh: "URL to the official Star Wars Databank entry"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /characters"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/characters"
          q: {
            exist: [
              "limit"
              "page"
            ]
          }
          s: [
            {
              lit: "characters"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /characters/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/characters/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "characters"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
