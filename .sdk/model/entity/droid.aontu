# Entity: droid

main: kit: entity: droid: {

  alias: field: {}

  fields: {
    affiliation: {
      h: "Affiliation"
      n: "affiliation"
      r: false
      sh: "Droid's affiliation"
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed description of the droid"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the droid"
      t: "`$STRING`"
    }
    image: {
      fo: "uri"
      h: "Image"
      n: "image"
      r: false
      sh: "URL to the droid's image"
      t: "`$STRING`"
    }
    manufacturer: {
      h: "Manufacturer"
      n: "manufacturer"
      r: false
      sh: "Droid's manufacturer"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name or designation of the droid"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "Droid type or class"
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      sh: "URL to the official Star Wars Databank entry"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "droid"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /droids"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/droids"
          q: {
            exist: [
              "limit"
              "page"
            ]
          }
          s: [
            {
              lit: "droids"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /droids/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/droids/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "droids"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
