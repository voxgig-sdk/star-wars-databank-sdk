# Entity: species

main: kit: entity: species: {

  alias: field: {}

  fields: {
    classification: {
      h: "Classification"
      n: "classification"
      r: false
      sh: "Biological classification"
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed description of the species"
      t: "`$STRING`"
    }
    designation: {
      h: "Designation"
      n: "designation"
      r: false
      sh: "Sentience designation"
      t: "`$STRING`"
    }
    homeworld: {
      h: "Homeworld"
      n: "homeworld"
      r: false
      sh: "Homeworld of the species"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the species"
      t: "`$STRING`"
    }
    image: {
      fo: "uri"
      h: "Image"
      n: "image"
      r: false
      sh: "URL to the species' image"
      t: "`$STRING`"
    }
    language: {
      h: "Language"
      n: "language"
      r: false
      sh: "Language spoken by the species"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the species"
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      sh: "URL to the official Star Wars Databank entry"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "species"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /species"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/species"
          q: {
            exist: [
              "limit"
              "page"
            ]
          }
          s: [
            {
              lit: "species"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /species/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/species/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "species"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
