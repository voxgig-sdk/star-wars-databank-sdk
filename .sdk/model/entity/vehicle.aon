# Entity: vehicle

main: kit: entity: vehicle: {

  alias: field: {}

  fields: [
    {
      name: "affiliation"
      req: false
      short: "Vehicle's affiliation"
      type: "`$STRING`"
    }
    {
      name: "armament"
      req: false
      short: "Vehicle armament"
      type: "`$STRING`"
    }
    {
      name: "class"
      req: false
      short: "Vehicle class or type"
      type: "`$STRING`"
    }
    {
      name: "crew"
      req: false
      short: "Crew capacity"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Detailed description of the vehicle"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the vehicle"
      type: "`$STRING`"
    }
    {
      name: "image"
      req: false
      short: "URL to the vehicle's image"
      type: "`$STRING`"
    }
    {
      name: "length"
      req: false
      short: "Length of the vehicle"
      type: "`$STRING`"
    }
    {
      name: "manufacturer"
      req: false
      short: "Vehicle manufacturer"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the vehicle"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "URL to the official Star Wars Databank entry"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "vehicle"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/vehicles"
          parts: [
            "vehicles"
          ]
          select: {
            exist: [
              "limit"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/vehicles/{id}"
          parts: [
            "vehicles"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
