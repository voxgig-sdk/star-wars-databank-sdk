# Entity: character

main: kit: entity: character: {

  alias: field: {}

  fields: [
    {
      name: "affiliation"
      req: false
      short: "Character's affiliation or allegiance"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Detailed description of the character"
      type: "`$STRING`"
    }
    {
      name: "homeworld"
      req: false
      short: "Character's home planet"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the character"
      type: "`$STRING`"
    }
    {
      name: "image"
      req: false
      short: "URL to the character's image"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the character"
      type: "`$STRING`"
    }
    {
      name: "species"
      req: false
      short: "Character's species"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "URL to the official Star Wars Databank entry"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/characters"
          parts: [
            "characters"
          ]
          select: {
            exist: [
              "limit"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/characters/{id}"
          parts: [
            "characters"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
