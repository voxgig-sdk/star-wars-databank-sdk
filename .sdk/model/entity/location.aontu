# Entity: location

main: kit: entity: location: {

  alias: field: {}

  fields: {
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed description of the location"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the location"
      t: "`$STRING`"
    }
    image: {
      fo: "uri"
      h: "Image"
      n: "image"
      r: false
      sh: "URL to the location's image"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the location"
      t: "`$STRING`"
    }
    region: {
      h: "Region"
      n: "region"
      r: false
      sh: "Galactic region where the location is situated"
      t: "`$STRING`"
    }
    sector: {
      h: "Sector"
      n: "sector"
      r: false
      sh: "Sector where the location is situated"
      t: "`$STRING`"
    }
    terrain: {
      h: "Terrain"
      n: "terrain"
      r: false
      sh: "Terrain type of the location"
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      sh: "URL to the official Star Wars Databank entry"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "location"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /locations"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/locations"
          q: {
            exist: [
              "limit"
              "page"
            ]
          }
          s: [
            {
              lit: "locations"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /locations/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/locations/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "locations"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
