# Entity: vehicle

main: kit: entity: vehicle: {

  alias: field: {}

  fields: {
    affiliation: {
      h: "Affiliation"
      n: "affiliation"
      r: false
      sh: "Vehicle's affiliation"
      t: "`$STRING`"
    }
    armament: {
      h: "Armament"
      n: "armament"
      r: false
      sh: "Vehicle armament"
      t: "`$STRING`"
    }
    class: {
      h: "Class"
      n: "class"
      r: false
      sh: "Vehicle class or type"
      t: "`$STRING`"
    }
    crew: {
      h: "Crew"
      n: "crew"
      r: false
      sh: "Crew capacity"
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed description of the vehicle"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the vehicle"
      t: "`$STRING`"
    }
    image: {
      fo: "uri"
      h: "Image"
      n: "image"
      r: false
      sh: "URL to the vehicle's image"
      t: "`$STRING`"
    }
    length: {
      h: "Length"
      n: "length"
      r: false
      sh: "Length of the vehicle"
      t: "`$STRING`"
    }
    manufacturer: {
      h: "Manufacturer"
      n: "manufacturer"
      r: false
      sh: "Vehicle manufacturer"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the vehicle"
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      sh: "URL to the official Star Wars Databank entry"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "vehicle"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /vehicles"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/vehicles"
          q: {
            exist: [
              "limit"
              "page"
            ]
          }
          s: [
            {
              lit: "vehicles"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /vehicles/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/vehicles/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "vehicles"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
