# BasicCreatureFlow

main: kit: flow: BasicCreatureFlow:
{
  entity: "creature",
  kind: "basic",
  name: "BasicCreatureFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "creature_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "creature_ref01",
        srcdatavar: "creature_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "creature01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-creature_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCreatureFlow"
}