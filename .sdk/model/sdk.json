  "main": {
    "kit": {
      "info": {
        "contact": {
          "url": "https://starwars-databank.vercel.app/"
        },
        "description": "The Star Wars Databank API provides access to a comprehensive collection of data related to the Star Wars universe including characters, droids, creatures, locations, organizations, species, and vehicles. It is a RESTful API that presents official information derived directly from the Star Wars Databank, allowing users to explore and interact with the vast lore of the saga.",
        "servers": [
          {
            "description": "Production server",
            "url": "https://starwars-databank-server.onrender.com/api/v1"
          }
        ],
        "title": "Star Wars Databank API",
        "version": "2.5.0",
        "tagline": "Browse Star Wars characters, droids, creatures, locations, organizations, species, and vehicles from a single unofficial Databank API",
        "homepage": "https://starwars-databank-server.onrender.com/api/v1",
        "docs_url": "https://freepublicapis.com/star-wars-databank-api",
        "license_short": "No licence specified by the API; Star Wars names and imagery remain trademarks of Lucasfilm Ltd.",
        "license_md": "- The API itself publishes no explicit licence or terms of use.\n- Star Wars characters, names, and imagery are trademarks of Lucasfilm Ltd. / The Walt Disney Company; treat the data as fan-curated reference material.\n- No authentication key is documented, but the service is community-hosted on Render and offered as-is without uptime guarantees.\n- Verify any commercial or redistribution use against Lucasfilm's IP terms before shipping.",
        "about_md": "The Star Wars Databank API is a community-run REST service that mirrors the kind of catalogue found on the official Star Wars Databank, exposing the universe's people, droids, creatures, places, factions, species, and ships through a single base URL at `https://starwars-databank-server.onrender.com/api/v1`.\n\nWhat you get from the API:\n\n- Paginated lists of entities (e.g. `GET /api/v1/characters?page=1&limit=10`) returning `_id`, `name`, `description`, and `image` fields plus `total`, `page`, `limit`, `next`, `prev` pagination metadata.\n- Separate collections per entity type: characters, droids, creatures, locations, organizations, species, and vehicles.\n- Free, key-less access suitable for demos, tutorials, and fan projects.\n\nOperational notes: the server is hosted on Render's free tier and may cold-start on first request. CORS is not enabled by default, so browser callers should proxy through their own backend. Individual endpoints have varied uptime historically (the `characters` route in particular has been flaky), so build in retries or fall back gracefully when a collection is unavailable.",
        "entity_desc": {
          "character": "A named Star Wars person or being — heroes, villains, and supporting cast — served from `/api/v1/characters` with `name`, `description`, and `image` fields.",
          "creature": "A non-sapient lifeform from the galaxy (banthas, rancors, dewbacks, etc.) listed under `/api/v1/creatures`.",
          "droid": "A mechanical character such as astromechs, protocol droids, and battle droids, available at `/api/v1/droids`.",
          "location": "A planet, moon, city, or other place in the Star Wars universe, served from `/api/v1/locations`.",
          "organization": "A faction, government, military, or guild (e.g. the Empire, Rebel Alliance, Jedi Order) exposed at `/api/v1/organizations`.",
          "species": "A sapient or notable biological species (Wookiees, Twi'leks, Hutts, etc.) listed under `/api/v1/species`.",
          "vehicle": "A ship, speeder, walker, or other craft from the saga, served from `/api/v1/vehicles`."
        },
        "auth": false
      },
      "config": {
        "auth": {
          "prefix": "Bearer"
        },
        "headers": {
          "content-type": "application/json"
        },
        "docs_order": [
          "ts",
          "py",
          "php",
          "go",
          "rb",
          "lua"
        ]
      },
